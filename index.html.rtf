\par
    const studentNameInput = document.getElementById("studentName");\par
    const studentClassInput = document.getElementById("studentClass");\par
    const studentNoInput = document.getElementById("studentNo");\par
\par
    function renderQuestions() \{\par
      questionsContainer.innerHTML = "";\par
\par
      QUESTIONS.forEach((q, idx) => \{\par
        const card = document.createElement("section");\par
        card.className = "card question-card";\par
        card.id = `question-card-$\{q.id\}`;\par
        card.dataset.qid = q.id;\par
\par
        let extraContentHTML = "";\par
        if (q.dataHighlight) \{\par
          extraContentHTML += `<div class="data-highlight-box">$\{q.dataHighlight\}</div>`;\par
        \}\par
        if (q.tableData) \{\par
          const rowsHTML = q.tableData.map(row => `\par
            <tr>\par
              <td>$\{row.interval\}</td>\par
              <td>$\{row.freq\}</td>\par
              <td>$\{row.highlight ? `<span class="highlight-var">$\{row.cum\}</span>` : row.cum\}</td>\par
            </tr>\par
          `).join("");\par
          extraContentHTML += `\par
            <div class="table-wrapper">\par
              <table class="freq-table">\par
                <thead>\par
                  <tr>\par
                    <th>\f1\fs28\lang1054\'cd\'d1\'b9\'b5\'c3\'c0\'d2\'a4\'aa\'d1\'e9\'b9\f0\fs22\lang1033 </th>\par
                    <th>\f1\fs28\lang1054\'a4\'c7\'d2\'c1\'b6\'d5\'e8\f2\fs22  \f0\lang1033 (f)</th>\par
                    <th>\f1\fs28\lang1054\'a4\'c7\'d2\'c1\'b6\'d5\'e8\'ca\'d0\'ca\'c1\f0\fs22\lang1033 </th>\par
                  </tr>\par
                </thead>\par
                <tbody>$\{rowsHTML\}</tbody>\par
              </table>\par
            </div>\par
          `;\par
        \}\par
\par
        const choicesHTML = q.choices.map((choiceText, cIdx) => `\par
          <label class="choice-label" id="label-q$\{q.id\}-c$\{cIdx\}">\par
            <input\par
              type="radio"\par
              class="choice-radio"\par
              name="question_$\{q.id\}"\par
              value="$\{cIdx\}"\par
              data-qid="$\{q.id\}"\par
              data-cidx="$\{cIdx\}"\par
            >\par
            <span class="choice-text">$\{choiceText\}</span>\par
            <span class="choice-feedback-tag" id="tag-q$\{q.id\}-c$\{cIdx\}" style="display:none;"></span>\par
          </label>\par
        `).join("");\par
\par
        const explanationListHTML = q.explanation.map(item => `<li>$\{item\}</li>`).join("");\par
\par
        card.innerHTML = `\par
          <div class="question-header">\par
            <h3 class="question-title">\f1\fs28\lang1054\'a2\'e9\'cd\'b7\'d5\'e8\f2\fs22  \f0\lang1033 $\{idx + 1\}. $\{q.question\} <span class="req-star">*</span></h3>\par
            <div class="question-meta">\par
              <span class="source-tag">$\{q.source\}</span>\par
              <span class="point-tag">1 \f1\fs28\lang1054\'a4\'d0\'e1\'b9\'b9\f0\fs22\lang1033 </span>\par
              <span class="status-badge" id="status-badge-$\{q.id\}"></span>\par
            </div>\par
          </div>\par
          $\{extraContentHTML\}\par
          <div class="choices-list" role="radiogroup" aria-label="\f1\fs28\lang1054\'b5\'d1\'c7\'e0\'c5\'d7\'cd\'a1\'ca\'d3\'cb\'c3\'d1\'ba\'a2\'e9\'cd\'b7\'d5\'e8\f2\fs22  \f0\lang1033 $\{idx + 1\}">\par
            $\{choicesHTML\}\par
          </div>\par
          <div class="explanation-box" id="explanation-$\{q.id\}">\par
            <div class="explanation-header">\f1\fs28\lang1054\'e0\'a9\'c5\'c2\'e1\'c5\'d0\'c7\'d4\'b8\'d5\'a4\'d4\'b4\'cd\'c2\'e8\'d2\'a7\'c5\'d0\'e0\'cd\'d5\'c2\'b4\f0\fs22\lang1033 :</div>\par
            <ul class="explanation-steps">\par
              $\{explanationListHTML\}\par
            </ul>\par
          </div>\par
        `;\par
\par
        questionsContainer.appendChild(card);\par
      \});\par
\par
      // Attach listeners to radio inputs\par
      const radios = questionsContainer.querySelectorAll(".choice-radio");\par
      radios.forEach(radio => \{\par
        radio.addEventListener("change", (e) => \{\par
          if (isSubmitted) return;\par
          const qid = parseInt(e.target.dataset.qid, 10);\par
          const cidx = parseInt(e.target.dataset.cidx, 10);\par
          userAnswers[qid] = cidx;\par
\par
          // Update visual selection state for this question\par
          const card = document.getElementById(`question-card-$\{qid\}`);\par
          card.classList.remove("unanswered-error");\par
          const labels = card.querySelectorAll(".choice-label");\par
          labels.forEach((lbl, i) => \{\par
            lbl.classList.toggle("selected", i === cidx);\par
          \});\par
\par
          updateProgress();\par
        \});\par
      \});\par
\par
      // Add click support directly to the label wrapper for absolute touch/click reliability\par
      const labels = questionsContainer.querySelectorAll(".choice-label");\par
      labels.forEach(lbl => \{\par
        lbl.addEventListener("click", (e) => \{\par
          if (isSubmitted) return;\par
          const radio = lbl.querySelector(".choice-radio");\par
          if (!radio || radio.disabled) return;\par
          \par
          // If user clicked outside the actual radio input element, trigger a click on the radio\par
          if (e.target !== radio) \{\par
            e.preventDefault();\par
            radio.click();\par
          \}\par
        \});\par
      \});\par
    \}\par
\par
    function updateProgress() \{\par
      const answeredCount = Object.keys(userAnswers).length;\par
      const total = QUESTIONS.length;\par
      const pct = Math.round((answeredCount / total) * 100);\par
      progressText.textContent = `\f1\fs28\lang1054\'b5\'cd\'ba\'e1\'c5\'e9\'c7\f2\fs22  \f0\lang1033 $\{answeredCount\} / $\{total\} \f1\fs28\lang1054\'a2\'e9\'cd\f0\fs22\lang1033 `;\par
      progressBar.setAttribute("aria-valuenow", String(answeredCount));\par
      progressFill.style.width = `$\{pct\}%`;\par
    \}\par
\par
    function validateField(inputEl, errorEl) \{\par
      const val = inputEl.value.trim();\par
      const valid = val.length > 0;\par
      inputEl.setAttribute("aria-invalid", valid ? "false" : "true");\par
      errorEl.classList.toggle("visible", !valid);\par
      return valid;\par
    \}\par
\par
    // Timer functions\par
    function startTimer() \{\par
      clearInterval(timerInterval);\par
      timeLeft = QUIZ_TIME_LIMIT_SECONDS;\par
      timeSpentSeconds = 0;\par
      updateTimerDisplay();\par
\par
      timerInterval = setInterval(() => \{\par
        if (isSubmitted) \{\par
          clearInterval(timerInterval);\par
          return;\par
        \}\par
\par
        timeLeft--;\par
        timeSpentSeconds++;\par
        updateTimerDisplay();\par
\par
        if (timeLeft <= 0) \{\par
          clearInterval(timerInterval);\par
          handleTimeout();\par
        \}\par
      \}, 1000);\par
    \}\par
\par
    function updateTimerDisplay() \{\par
      const minutes = Math.floor(timeLeft / 60);\par
      const seconds = timeLeft % 60;\par
      const displayStr = `$\{String(minutes).padStart(2, '0')\}:$\{String(seconds).padStart(2, '0')\}`;\par
      \par
      timerLabel.textContent = `\f1\fs28\lang1054\'e0\'c7\'c5\'d2\'b7\'d5\'e8\'e0\'cb\'c5\'d7\'cd\f0\fs22\lang1033 : $\{displayStr\} \f1\fs28\lang1054\'b9\f0\fs22\lang1033 .`;\par
\par
      if (timeLeft <= 120) \{ // Warning: Less than or equal to 2 mins left\par
        timerWrap.classList.add("warning");\par
      \} else \{\par
        timerWrap.classList.remove("warning");\par
      \}\par
    \}\par
\par
    function handleTimeout() \{\par
      // Automatically lock and grade the quiz\par
      validationBanner.innerHTML = "<strong>\f1\fs28\lang1054\'cb\'c1\'b4\'e0\'c7\'c5\'d2\'b7\'d3\'a2\'e9\'cd\'ca\'cd\'ba\'e1\'c5\'e9\'c7\f0\fs22\lang1033 !</strong> \f1\fs28\lang1054\'c3\'d0\'ba\'ba\'e4\'b4\'e9\'b7\'d3\'a1\'d2\'c3\'ba\'d1\'b9\'b7\'d6\'a1\'e1\'c5\'d0\'ca\'e8\'a7\'a4\'d3\'b5\'cd\'ba\'bb\'d1\'a8\'a8\'d8\'ba\'d1\'b9\'a2\'cd\'a7\'a4\'d8\'b3\'cd\'d1\'b5\'e2\'b9\'c1\'d1\'b5\'d4\f0\fs22\lang1033 ";\par
      validationBanner.classList.add("visible");\par
      \par
      // Auto-set mock values for empty student info if blank\par
      if (!studentNameInput.value.trim()) studentNameInput.value = "\f1\fs28\lang1054\'bc\'d9\'e9\'e0\'a2\'e9\'d2\'ca\'cd\'ba\'cb\'c1\'b4\'e0\'c7\'c5\'d2\f0\fs22\lang1033 ";\par
      if (!studentClassInput.value.trim()) studentClassInput.value = "\f1\fs28\lang1054\'e4\'c1\'e8\'e4\'b4\'e9\'c3\'d0\'ba\'d8\f0\fs22\lang1033 ";\par
      if (!studentNoInput.value.trim()) studentNoInput.value = "-";\par
      \par
      gradeQuiz();\par
    \}\par
\par
    [\par
      [studentNameInput, document.getElementById("nameError")],\par
      [studentClassInput, document.getElementById("classError")],\par
      [studentNoInput, document.getElementById("noError")]\par
    ].forEach(([inputEl, errorEl]) => \{\par
      inputEl.addEventListener("blur", () => \{\par
        if (!isSubmitted) validateField(inputEl, errorEl);\par
      \});\par
      inputEl.addEventListener("input", () => \{\par
        if (inputEl.getAttribute("aria-invalid") === "true") \{\par
          validateField(inputEl, errorEl);\par
        \}\par
      \});\par
    \});\par
\par
    quizForm.addEventListener("submit", (e) => \{\par
      e.preventDefault();\par
      if (isSubmitted) return;\par
\par
      const nameOk = validateField(studentNameInput, document.getElementById("nameError"));\par
      const classOk = validateField(studentClassInput, document.getElementById("classError"));\par
      const noOk = validateField(studentNoInput, document.getElementById("noError"));\par
\par
      const unansweredIds = [];\par
      QUESTIONS.forEach(q => \{\par
        const card = document.getElementById(`question-card-$\{q.id\}`);\par
        if (userAnswers[q.id] === undefined) \{\par
          unansweredIds.push(q.id);\par
          card.classList.add("unanswered-error");\par
        \} else \{\par
          card.classList.remove("unanswered-error");\par
        \}\par
      \});\par
\par
      if (!nameOk || !classOk || !noOk || unansweredIds.length > 0) \{\par
        const messages = [];\par
        if (!nameOk || !classOk || !noOk) \{\par
          messages.push("\f1\fs28\lang1054\'a1\'c3\'d8\'b3\'d2\'a1\'c3\'cd\'a1\'a2\'e9\'cd\'c1\'d9\'c5\'bc\'d9\'e9\'e0\'a2\'e9\'d2\'ca\'cd\'ba\f2\fs22  \f0\lang1033 (\f1\fs28\lang1054\'aa\'d7\'e8\'cd\f0\fs22\lang1033 -\f1\fs28\lang1054\'b9\'d2\'c1\'ca\'a1\'d8\'c5\f0\fs22\lang1033 , \f1\fs28\lang1054\'c3\'d0\'b4\'d1\'ba\'aa\'d1\'e9\'b9\f0\fs22\lang1033 , \f1\fs28\lang1054\'c3\'cb\'d1\'ca\'b9\'d1\'a1\'c8\'d6\'a1\'c9\'d2\f0\fs22\lang1033 ) \f1\fs28\lang1054\'e3\'cb\'e9\'a4\'c3\'ba\'b6\'e9\'c7\'b9\f0\fs22\lang1033 ");\par
        \}\par
        if (unansweredIds.length > 0) \{\par
          messages.push(`\f1\fs28\lang1054\'c2\'d1\'a7\'e4\'c1\'e8\'e4\'b4\'e9\'e0\'c5\'d7\'cd\'a1\'a4\'d3\'b5\'cd\'ba\'e3\'b9\'a2\'e9\'cd\'b7\'d5\'e8\f0\fs22\lang1033 : $\{unansweredIds.join(", ")\} (\f1\fs28\lang1054\'a1\'c3\'d8\'b3\'d2\'b7\'d3\'a2\'e9\'cd\'ca\'cd\'ba\'e3\'cb\'e9\'a4\'c3\'ba\'b7\'d1\'e9\'a7\f2\fs22  \f0\lang1033 10 \f1\fs28\lang1054\'a2\'e9\'cd\'a1\'e8\'cd\'b9\'ca\'e8\'a7\f0\fs22\lang1033 )`);\par
        \}\par
        validationBanner.innerHTML = messages.join("<br>");\par
        validationBanner.classList.add("visible");\par
\par
        // Scroll to the first error\par
        if (!nameOk || !classOk || !noOk) \{\par
          document.getElementById("studentInfoCard").scrollIntoView(\{ behavior: "smooth", block: "center" \});\par
        \} else if (unansweredIds.length > 0) \{\par
          document.getElementById(`question-card-$\{unansweredIds[0]\}`).scrollIntoView(\{ behavior: "smooth", block: "center" \});\par
        \}\par
        return;\par
      \}\par
\par
      validationBanner.classList.remove("visible");\par
      gradeQuiz();\par
    \});\par
\par
    function gradeQuiz() \{\par
      isSubmitted = true;\par
      clearInterval(timerInterval);\par
      let score = 0;\par
\par
      // Lock student inputs\par
      studentNameInput.disabled = true;\par
      studentClassInput.disabled = true;\par
      studentNoInput.disabled = true;\par
\par
      QUESTIONS.forEach(q => \{\par
        const selectedIdx = userAnswers[q.id];\par
        const isCorrect = selectedIdx === q.correctIndex;\par
        if (isCorrect) score++;\par
\par
        const card = document.getElementById(`question-card-$\{q.id\}`);\par
        card.classList.add(isCorrect ? "graded-correct" : "graded-incorrect");\par
        card.dataset.correct = isCorrect ? "true" : "false";\par
\par
        // Status badge\par
        const badge = document.getElementById(`status-badge-$\{q.id\}`);\par
        badge.className = `status-badge $\{isCorrect ? "correct" : "incorrect"\}`;\par
        badge.textContent = isCorrect ? "\f8\fs20\u10003?\f4\fs22  \f1\fs28\lang1054\'b5\'cd\'ba\'b6\'d9\'a1\f2\fs22  \f0\lang1033 (+1 \f1\fs28\lang1054\'a4\'d0\'e1\'b9\'b9\f0\fs22\lang1033 )" : "\f8\fs20\u10005?\f4\fs22  \f1\fs28\lang1054\'b5\'cd\'ba\'bc\'d4\'b4\f2\fs22  \f0\lang1033 (0 \f1\fs28\lang1054\'a4\'d0\'e1\'b9\'b9\f0\fs22\lang1033 )";\par
\par
        // Highlight choices & lock radios\par
        q.choices.forEach((_, cIdx) => \{\par
          const label = document.getElementById("label-q" + q.id + "-c" + cIdx);\par
          const tag = document.getElementById("tag-q" + q.id + "-c" + cIdx);\par
          const radio = label.querySelector(".choice-radio");\par
          if (radio) radio.disabled = true;\par
          label.classList.add("disabled");\par
          label.classList.remove("selected");\par
\par
          if (cIdx === selectedIdx) \{\par
            if (isCorrect) \{\par
              label.classList.add("correct-choice");\par
              tag.style.display = "inline-block";\par
              tag.className = "choice-feedback-tag tag-correct";\par
              tag.textContent = "\f1\fs28\lang1054\'a4\'d3\'b5\'cd\'ba\'a2\'cd\'a7\'a4\'d8\'b3\f2\fs22  \f0\lang1033 (\f1\fs28\lang1054\'b6\'d9\'a1\'b5\'e9\'cd\'a7\f0\fs22\lang1033 )";\par
            \} else \{\par
              label.classList.add("wrong-choice");\par
              tag.style.display = "inline-block";\par
              tag.className = "choice-feedback-tag tag-wrong";\par
              tag.textContent = "\f1\fs28\lang1054\'a4\'d3\'b5\'cd\'ba\'b7\'d5\'e8\'a4\'d8\'b3\'e0\'c5\'d7\'cd\'a1\f2\fs22  \f0\lang1033 (\f1\fs28\lang1054\'bc\'d4\'b4\f0\fs22\lang1033 )";\par
            \}\par
          \}\par
        \});\par
\par
        // Hiding explanation boxes to keep correct choices concealed\par
        const expBox = document.getElementById(`explanation-$\{q.id\}`);\par
        if (expBox) expBox.classList.remove("visible");\par
      \});\par
\par
      const wrongCount = QUESTIONS.length - score;\par
      const percent = Math.round((score / QUESTIONS.length) * 100);\par
\par
      // Human-readable time spent\par
      const spentMin = Math.floor(timeSpentSeconds / 60);\par
      const spentSec = timeSpentSeconds % 60;\par
      const spentStr = spentMin > 0 ? spentMin + " \f1\fs28\lang1054\'b9\'d2\'b7\'d5\f2\fs22  \f0\lang1033 " + spentSec + " \f1\fs28\lang1054\'c7\'d4\'b9\'d2\'b7\'d5\f0\fs22\lang1033 " : spentSec + " \f1\fs28\lang1054\'c7\'d4\'b9\'d2\'b7\'d5\f0\fs22\lang1033 ";\par
\par
      document.getElementById("resultStudentName").textContent =\par
        "\f1\fs28\lang1054\'bc\'d9\'e9\'e0\'a2\'e9\'d2\'ca\'cd\'ba\f0\fs22\lang1033 : " + studentNameInput.value.trim();\par
      document.getElementById("resultStudentMeta").textContent =\par
        "\f1\fs28\lang1054\'c3\'d0\'b4\'d1\'ba\'aa\'d1\'e9\'b9\f0\fs22\lang1033 /\f1\fs28\lang1054\'cb\'e9\'cd\'a7\f0\fs22\lang1033 : " + studentClassInput.value.trim() + "  |  \f1\fs28\lang1054\'c3\'cb\'d1\'ca\'b9\'d1\'a1\'c8\'d6\'a1\'c9\'d2\f0\fs22\lang1033 : " + studentNoInput.value.trim();\par
      document.getElementById("resultTimeMeta").textContent = \par
        "\f3\fs20\u9201?\u-497?\f4\fs22  \f1\fs28\lang1054\'e0\'c7\'c5\'d2\'b7\'d5\'e8\'e3\'aa\'e9\'b7\'d3\'a2\'e9\'cd\'ca\'cd\'ba\f0\fs22\lang1033 : " + spentStr + " (\f1\fs28\lang1054\'a8\'d2\'a1\'e0\'c7\'c5\'d2\'b7\'d1\'e9\'a7\'cb\'c1\'b4\f2\fs22  \f0\lang1033 30 \f1\fs28\lang1054\'b9\'d2\'b7\'d5\f0\fs22\lang1033 )";\par
      \par
      document.getElementById("resultScoreText").textContent = score + " / " + QUESTIONS.length;\par
      document.getElementById("statCorrect").textContent = "\f1\fs28\lang1054\'b5\'cd\'ba\'b6\'d9\'a1\f2\fs22  \f0\lang1033 " + score + " \f1\fs28\lang1054\'a2\'e9\'cd\f0\fs22\lang1033 ";\par
      document.getElementById("statIncorrect").textContent = "\f1\fs28\lang1054\'b5\'cd\'ba\'bc\'d4\'b4\f2\fs22  \f0\lang1033 " + wrongCount + " \f1\fs28\lang1054\'a2\'e9\'cd\f0\fs22\lang1033 ";\par
      document.getElementById("statPercent").textContent = "\f1\fs28\lang1054\'a4\'d4\'b4\'e0\'bb\'e7\'b9\'c3\'e9\'cd\'c2\'c5\'d0\f2\fs22  \f0\lang1033 " + percent + "%";\par
\par
      filterAllBtn.textContent = "\f1\fs28\lang1054\'b4\'d9\'b7\'d8\'a1\'a2\'e9\'cd\f2\fs22  \f0\lang1033 (" + QUESTIONS.length + ")";\par
      filterWrongBtn.textContent = "\f1\fs28\lang1054\'b4\'d9\'e0\'a9\'be\'d2\'d0\'a2\'e9\'cd\'b7\'d5\'e8\'b5\'cd\'ba\'bc\'d4\'b4\f2\fs22  \f0\lang1033 (" + wrongCount + ")";\par
\par
      scoreBanner.classList.add("visible");\par
      \par
      // Keep submit button visible but state changed to indicate sync status\par
      submitBtn.disabled = true;\par
      submitBtn.style.display = "inline-flex";\par
      submitBtn.style.opacity = "0.7";\par
      submitBtn.textContent = "\f1\fs28\lang1054\'ba\'d1\'b9\'b7\'d6\'a1\'bc\'c5\'a4\'d0\'e1\'b9\'b9\'e0\'ca\'c3\'e7\'a8\'ca\'d4\'e9\'b9\f0\fs22\lang1033 ";\par
\par
      const payload = \{\par
        name: studentNameInput.value.trim(),\par
        className: studentClassInput.value.trim(),\par
        studentId: studentNoInput.value.trim(),\par
        score: score,\par
        timeSpent: spentStr,\par
        timestamp: new Date().toISOString()\par
      \};\par
\par
      const webAppUrl = "https://script.google.com/macros/s/AKfycbxkcdpQK3DVMNwXLpAVmsG-f05U-fTOTFyuLVgLRVPAiTQ1IV2FXdnNHfSyRH6qfFWh/exec";\par
\par
      // Send to Google Sheets if deployed on Apps Script as a Web App\par
      if (typeof google !== 'undefined' && google.script && google.script.run) \{\par
        submitBtn.textContent = "\f1\fs28\lang1054\'a1\'d3\'c5\'d1\'a7\'ba\'d1\'b9\'b7\'d6\'a1\'a4\'d0\'e1\'b9\'b9\'c5\'a7\f2\fs22  \f0\lang1033 Google Sheet...";\par
        google.script.run\par
          .withSuccessHandler(() => \{\par
            submitBtn.textContent = "\f8\fs20\u9989?\f4\fs22  \f1\fs28\lang1054\'ba\'d1\'b9\'b7\'d6\'a1\'a4\'d0\'e1\'b9\'b9\'c5\'a7\f2\fs22  \f0\lang1033 Sheet \f1\fs28\lang1054\'ca\'d3\'e0\'c3\'e7\'a8\f0\fs22\lang1033 !";\par
            setTimeout(() => \{\par
              submitBtn.style.display = "none";\par
            \}, 3000);\par
          \})\par
          .withFailureHandler(() => \{\par
            submitToSheetViaFetch(webAppUrl, payload);\par
          \})\par
          .recordScore(payload);\par
      \} else \{\par
        // If running standalone (Offline/Directly) - Bypasses Google multi-account bug!\par
        submitToSheetViaFetch(webAppUrl, payload);\par
      \}\par
\par
      clearBtn.style.display = "none";\par
      retakeBtn.style.display = "inline-flex";\par
\par
      scoreBanner.scrollIntoView(\{ behavior: "smooth", block: "start" \});\par
    \}\par
\par
    function applyFilter(mode) \{\par
      currentFilter = mode;\par
      filterAllBtn.classList.toggle("active", mode === "all");\par
      filterWrongBtn.classList.toggle("active", mode === "wrong");\par
\par
      QUESTIONS.forEach(q => \{\par
        const card = document.getElementById(`question-card-$\{q.id\}`);\par
        if (mode === "all") \{\par
          card.style.display = "block";\par
        \} else \{\par
          const isCorrect = card.dataset.correct === "true";\par
          card.style.display = isCorrect ? "none" : "block";\par
        \}\par
      \});\par
    \}\par
\par
    filterAllBtn.addEventListener("click", () => applyFilter("all"));\par
    filterWrongBtn.addEventListener("click", () => applyFilter("wrong"));\par
\par
    function resetQuiz(keepStudentInfo = false) \{\par
      isSubmitted = false;\par
      userAnswers = \{\};\par
      currentFilter = "all";\par
\par
      if (!keepStudentInfo) \{\par
        studentNameInput.value = "";\par
        studentClassInput.value = "";\par
        studentNoInput.value = "";\par
      \}\par
\par
      studentNameInput.disabled = false;\par
      studentClassInput.disabled = false;\par
      studentNoInput.disabled = false;\par
      studentNameInput.setAttribute("aria-invalid", "false");\par
      studentClassInput.setAttribute("aria-invalid", "false");\par
      studentNoInput.setAttribute("aria-invalid", "false");\par
      document.getElementById("nameError").classList.remove("visible");\par
      document.getElementById("classError").classList.remove("visible");\par
      document.getElementById("noError").classList.remove("visible");\par
\par
      validationBanner.classList.remove("visible");\par
      scoreBanner.classList.remove("visible");\par
\par
      submitBtn.style.display = "inline-flex";\par
      clearBtn.style.display = "inline-flex";\par
      retakeBtn.style.display = "none";\par
\par
      filterAllBtn.classList.add("active");\par
      filterWrongBtn.classList.remove("active");\par
\par
      renderQuestions();\par
      updateProgress();\par
      startTimer();\par
      window.scrollTo(\{ top: 0, behavior: "smooth" \});\par
    \}\par
\par
    clearBtn.addEventListener("click", () => resetQuiz(true));\par
    retakeBtn.addEventListener("click", () => resetQuiz(true));\par
\par
    function submitToSheetViaFetch(url, payload) \{\par
      submitBtn.textContent = "\f1\fs28\lang1054\'a1\'d3\'c5\'d1\'a7\'ca\'e8\'a7\'a4\'d0\'e1\'b9\'b9\'e4\'bb\'c2\'d1\'a7\f2\fs22  \f0\lang1033 Google Sheet...";\par
      \par
      fetch(url, \{\par
        method: "POST",\par
        mode: "no-cors", // Bypasses CORS and multi-account login check!\par
        cache: "no-cache",\par
        headers: \{\par
          "Content-Type": "text/plain"\par
        \},\par
        body: JSON.stringify(payload)\par
      \})\par
      .then(() => \{\par
        submitBtn.textContent = "\f8\fs20\u9989?\f4\fs22  \f1\fs28\lang1054\'ca\'e8\'a7\'a4\'d0\'e1\'b9\'b9\'e0\'ca\'c3\'e7\'a8\'ca\'d4\'e9\'b9\f0\fs22\lang1033 !";\par
        setTimeout(() => \{\par
          submitBtn.style.display = "none";\par
        \}, 3000);\par
      \})\par
      .catch((err) => \{\par
        console.error("Fetch error:", err);\par
        submitBtn.textContent = "\f8\fs20\u10060?\f4\fs22  \f1\fs28\lang1054\'ba\'d1\'b9\'b7\'d6\'a1\'a4\'d0\'e1\'b9\'b9\'c5\'e9\'c1\'e0\'cb\'c5\'c7\f0\fs22\lang1033 ";\par
        submitBtn.disabled = false;\par
        submitBtn.style.opacity = "1";\par
      \});\par
    \}\par
\par
    function setupShareFeature() \{\par
      let currentUrl = window.location.href;\par
      \par
      // Fallback if sandboxed or empty\par
      if (currentUrl.includes("srcdoc") || currentUrl === "about:blank" || !currentUrl.startsWith("http")) \{\par
        currentUrl = "about:invalid#zPythonSafez";\par
      \}\par
\par
      const shareUrlInput = document.getElementById("shareUrlInput");\par
      const copyUrlBtn = document.getElementById("copyUrlBtn");\par
\par
      shareUrlInput.value = currentUrl;\par
\par
      copyUrlBtn.addEventListener("click", () => \{\par
        try \{\par
          navigator.clipboard.writeText(currentUrl).then(() => \{\par
            copyUrlBtn.innerHTML = "\f8\fs20\u9989?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'ca\'d3\'e0\'c3\'e7\'a8\'e1\'c5\'e9\'c7\f0\fs22\lang1033 !";\par
            setTimeout(() => \{\par
              copyUrlBtn.innerHTML = "\f5\fs20\u-10179?\u-9013?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'e1\'ba\'ba\'b7\'b4\'ca\'cd\'ba\f0\fs22\lang1033 ";\par
            \}, 2000);\par
          \}).catch(() => \{\par
            shareUrlInput.select();\par
            document.execCommand("copy");\par
            copyUrlBtn.innerHTML = "\f8\fs20\u9989?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'ca\'d3\'e0\'c3\'e7\'a8\'e1\'c5\'e9\'c7\f0\fs22\lang1033 !";\par
            setTimeout(() => \{\par
              copyUrlBtn.innerHTML = "\f5\fs20\u-10179?\u-9013?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'e1\'ba\'ba\'b7\'b4\'ca\'cd\'ba\f0\fs22\lang1033 ";\par
            \}, 2000);\par
          \});\par
        \} catch (e) \{\par
          shareUrlInput.select();\par
          document.execCommand("copy");\par
          copyUrlBtn.innerHTML = "\f8\fs20\u9989?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'ca\'d3\'e0\'c3\'e7\'a8\'e1\'c5\'e9\'c7\f0\fs22\lang1033 !";\par
          setTimeout(() => \{\par
            copyUrlBtn.innerHTML = "\f5\fs20\u-10179?\u-9013?\f4\fs22  \f1\fs28\lang1054\'a4\'d1\'b4\'c5\'cd\'a1\'c5\'d4\'a7\'a1\'ec\'e1\'ba\'ba\'b7\'b4\'ca\'cd\'ba\f0\fs22\lang1033 ";\par
          \}, 2000);\par
        \}\par
      \});\par
    \}\par
\par
    // Initialize\par
    renderQuestions();\par
    updateProgress();\par
    startTimer();\par
    setupShareFeature();\par
  </script>\par
</body>\par
</html>\lang17\par
}
