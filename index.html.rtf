    const QUIZ_TIME_LIMIT_SECONDS = 30 * 60; // 15 minutes\par
    let timeLeft = QUIZ_TIME_LIMIT_SECONDS;\par
    let timerInterval = null;\par
    let timeSpentSeconds = 0;\par
\par
