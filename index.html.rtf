\pard\sa200\sl276\slmult1\f0\fs22\lang17 <!doctype html>\par
<html lang="th">\par
<head>\par
  <meta charset="utf-8">\par
  <meta name="viewport" content="width=device-width, initial-scale=1">\par
  <title>\f1\fs28\'e1\'ba\'ba\'b7\'b4\'ca\'cd\'ba\'a1\'e8\'cd\'b9\'e0\'c3\'d5\'c2\'b9\f2\fs22\lang1054  \f1\fs28\'e0\'c3\'d7\'e8\'cd\'a7\f2\fs22  \f1\fs28\'ca\'b6\'d4\'b5\'d4\'e0\'ba\'d7\'e9\'cd\'a7\'b5\'e9\'b9\f2\fs22  \f0\lang1033 (10 \f1\fs28\lang1054\'a2\'e9\'cd\f0\fs22\lang1033 )</title>\par
  <link rel="preconnect" href="https://fonts.googleapis.com">\par
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\par
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">\par
  <style>\par
    :root \{\par
      --navy: #5D2689; /* Royal Purple of Department of Learning Promotion */\par
      --orange: #FFCB05; /* Vibrant Gold/Yellow of Department of Learning Promotion */\par
      --red: #C0392B;\par
      --coral: #FFB800;\par
      --periwinkle: #9B72BF;\par
      --lavender: #EADCF5;\par
      --bg: #FAFAF7;\par
      --surface: #FFFFFF;\par
      --border: #E5D5F2;\par
      --ink: #3D1361;\par
      --body-ink: #260C3D;\par
      --muted: #6B5580;\par
      --success: #1E7E34;\par
      --success-bg: #EBF9EE;\par
      --success-border: #A3E0B0;\par
      --error-bg: #FDF0EE;\par
      --error-border: #F5B7B1;\par
      --radius: 12px;\par
      --shadow: 0 2px 8px rgba(93, 38, 137, 0.06), 0 1px 3px rgba(93, 38, 137, 0.04);\par
      --space-1: 4px;\par
      --space-2: 8px;\par
      --space-3: 12px;\par
      --space-4: 16px;\par
      --space-6: 24px;\par
      --space-8: 32px;\par
      --font: "lookpeach", "Sarabun", "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;\par
    \}\par
\par
    * \{\par
      box-sizing: border-box;\par
    \}\par
\par
    body \{\par
      margin: 0;\par
      font-family: var(--font);\par
      color: var(--body-ink);\par
      background: var(--bg);\par
      background-image:\par
        linear-gradient(rgba(234, 220, 245, 0.25) 1px, transparent 1px),\par
        linear-gradient(90deg, rgba(234, 220, 245, 0.25) 1px, transparent 1px);\par
      background-size: 32px 32px;\par
      line-height: 1.6;\par
      font-size: 16px;\par
    \}\par
\par
    .top-bar \{\par
      position: sticky;\par
      top: 0;\par
      z-index: 100;\par
      background: var(--surface);\par
      border-bottom: 2px solid var(--lavender);\par
      box-shadow: 0 2px 10px rgba(0, 9, 107, 0.05);\par
    \}\par
\par
    .top-bar-inner \{\par
      max-width: 820px;\par
      margin: 0 auto;\par
      padding: var(--space-3) var(--space-6);\par
      display: flex;\par
      align-items: center;\par
      justify-content: space-between;\par
      gap: var(--space-4);\par
      flex-wrap: wrap;\par
    \}\par
\par
    .brand-title \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-3);\par
      font-weight: 700;\par
      color: var(--navy);\par
      font-size: 18px;\par
    \}\par
\par
    .brand-badge \{\par
      background: var(--navy);\par
      color: #FFFFFF;\par
      font-size: 13px;\par
      font-weight: 700;\par
      padding: 4px 10px;\par
      border-radius: 6px;\par
      letter-spacing: 0.3px;\par
    \}\par
\par
    .top-bar-controls \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-4);\par
      flex-wrap: wrap;\par
      flex: 1;\par
      justify-content: flex-end;\par
    \}\par
\par
    .timer-wrap \{\par
      display: inline-flex;\par
      align-items: center;\par
      gap: 6px;\par
      background: #F4F6FF;\par
      border: 1.5px solid var(--periwinkle);\par
      padding: 6px 14px;\par
      border-radius: 8px;\par
      font-weight: 700;\par
      color: var(--navy);\par
      font-size: 15px;\par
      transition: all 0.3s ease;\par
    \}\par
\par
    .timer-wrap.warning \{\par
      background: var(--error-bg);\par
      border-color: var(--red);\par
      color: var(--red);\par
      animation: pulse 1s infinite alternate;\par
    \}\par
\par
    @keyframes pulse \{\par
      from \{ transform: scale(1); \}\par
      to \{ transform: scale(1.04); \}\par
    \}\par
\par
    .progress-wrap \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-3);\par
      max-width: 260px;\par
      flex: 1;\par
    \}\par
\par
    .progress-label \{\par
      font-size: 14px;\par
      font-weight: 600;\par
      color: var(--navy);\par
      white-space: nowrap;\par
    \}\par
\par
    .progress-track \{\par
      flex: 1;\par
      height: 8px;\par
      background: var(--lavender);\par
      border-radius: 999px;\par
      overflow: hidden;\par
      min-width: 90px;\par
    \}\par
\par
    .progress-fill \{\par
      height: 100%;\par
      width: 0%;\par
      background: var(--orange);\par
      border-radius: 999px;\par
      transition: width 0.25s ease;\par
    \}\par
\par
    .container \{\par
      max-width: 820px;\par
      margin: 0 auto;\par
      padding: var(--space-6) var(--space-4) 48px;\par
    \}\par
\par
    /* Header Banner styled after Google Forms + PDF Brand Kit */\par
    .quiz-header-card \{\par
      background: var(--surface);\par
      border: 2px solid var(--navy);\par
      border-top: 10px solid var(--navy);\par
      border-radius: var(--radius);\par
      box-shadow: var(--shadow);\par
      padding: var(--space-6);\par
      margin-bottom: var(--space-6);\par
      position: relative;\par
    \}\par
\par
    .quiz-course-tag \{\par
      display: inline-block;\par
      background: var(--lavender);\par
      color: var(--navy);\par
      font-weight: 700;\par
      font-size: 13px;\par
      padding: 4px 12px;\par
      border-radius: 999px;\par
      margin-bottom: var(--space-2);\par
    \}\par
\par
    .quiz-header-card h1 \{\par
      margin: 0 0 var(--space-2) 0;\par
      font-size: 26px;\par
      color: var(--navy);\par
      line-height: 1.3;\par
    \}\par
\par
    .quiz-subtitle \{\par
      margin: 0 0 var(--space-4) 0;\par
      color: var(--muted);\par
      font-size: 15px;\par
    \}\par
\par
    .quiz-meta-strip \{\par
      display: flex;\par
      flex-wrap: wrap;\par
      gap: var(--space-3);\par
      padding-top: var(--space-3);\par
      border-top: 1px dashed var(--lavender);\par
      font-size: 14px;\par
      color: var(--navy);\par
      font-weight: 600;\par
    \}\par
\par
    .meta-pill \{\par
      display: inline-flex;\par
      align-items: center;\par
      gap: 6px;\par
      background: #F4F6FF;\par
      border: 1px solid var(--lavender);\par
      padding: 4px 12px;\par
      border-radius: 8px;\par
    \}\par
\par
    /* Score Report Card (Visible after submission) */\par
    .score-banner \{\par
      display: none;\par
      background: var(--surface);\par
      border: 2px solid var(--navy);\par
      border-top: 8px solid var(--orange);\par
      border-radius: var(--radius);\par
      box-shadow: var(--shadow);\par
      padding: var(--space-6);\par
      margin-bottom: var(--space-6);\par
    \}\par
\par
    .score-banner.visible \{\par
      display: block;\par
    \}\par
\par
    .score-banner-top \{\par
      display: flex;\par
      flex-wrap: wrap;\par
      align-items: center;\par
      justify-content: space-between;\par
      gap: var(--space-4);\par
      padding-bottom: var(--space-4);\par
      border-bottom: 1px solid var(--lavender);\par
    \}\par
\par
    .score-student-info h2 \{\par
      margin: 0 0 4px 0;\par
      font-size: 22px;\par
      color: var(--navy);\par
    \}\par
\par
    .score-student-details \{\par
      margin: 0;\par
      color: var(--muted);\par
      font-size: 15px;\par
    \}\par
\par
    .score-circle-box \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-4);\par
      background: var(--lavender);\par
      padding: var(--space-4) var(--space-6);\par
      border-radius: var(--radius);\par
      border: 2px solid var(--navy);\par
    \}\par
\par
    .score-big \{\par
      font-size: 36px;\par
      font-weight: 700;\par
      color: var(--navy);\par
      line-height: 1;\par
    \}\par
\par
    .score-unit \{\par
      font-size: 14px;\par
      font-weight: 600;\par
      color: var(--navy);\par
    \}\par
\par
    .score-summary-bar \{\par
      display: flex;\par
      flex-wrap: wrap;\par
      align-items: center;\par
      justify-content: space-between;\par
      gap: var(--space-3);\par
      margin-top: var(--space-4);\par
    \}\par
\par
    .score-stats \{\par
      display: flex;\par
      flex-wrap: wrap;\par
      gap: var(--space-3);\par
    \}\par
\par
    .stat-chip \{\par
      font-size: 14px;\par
      font-weight: 600;\par
      padding: 6px 14px;\par
      border-radius: 8px;\par
    \}\par
\par
    .stat-chip.correct \{\par
      background: var(--success-bg);\par
      color: var(--success);\par
      border: 1px solid var(--success-border);\par
    \}\par
\par
    .stat-chip.incorrect \{\par
      background: var(--error-bg);\par
      color: var(--red);\par
      border: 1px solid var(--error-border);\par
    \}\par
\par
    .stat-chip.percent \{\par
      background: #FFF4EC;\par
      color: #B84B0B;\par
      border: 1px solid var(--coral);\par
    \}\par
\par
    /* Section Card */\par
    .card \{\par
      background: var(--surface);\par
      border: 1px solid var(--border);\par
      border-radius: var(--radius);\par
      box-shadow: var(--shadow);\par
      padding: var(--space-6);\par
      margin-bottom: var(--space-4);\par
      transition: border-color 0.2s ease, box-shadow 0.2s ease;\par
    \}\par
\par
    .card.unanswered-error \{\par
      border: 2px solid var(--red);\par
      background: #FFFDFD;\par
    \}\par
\par
    .card.graded-correct \{\par
      border-left: 6px solid var(--success);\par
    \}\par
\par
    .card.graded-incorrect \{\par
      border-left: 6px solid var(--red);\par
    \}\par
\par
    .section-title \{\par
      margin: 0 0 var(--space-4) 0;\par
      font-size: 18px;\par
      color: var(--navy);\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-2);\par
      padding-bottom: var(--space-2);\par
      border-bottom: 2px dashed var(--orange);\par
    \}\par
\par
    .student-grid \{\par
      display: grid;\par
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));\par
      gap: var(--space-4);\par
    \}\par
\par
    .form-group \{\par
      display: flex;\par
      flex-direction: column;\par
      gap: 6px;\par
    \}\par
\par
    .form-group label \{\par
      font-size: 14px;\par
      font-weight: 700;\par
      color: var(--navy);\par
    \}\par
\par
    .req-star \{\par
      color: var(--red);\par
      margin-left: 2px;\par
    \}\par
\par
    .form-input \{\par
      font: inherit;\par
      padding: 10px 14px;\par
      border: 1.5px solid var(--periwinkle);\par
      border-radius: 8px;\par
      color: var(--body-ink);\par
      background: #FFFFFF;\par
      transition: border-color 0.15s ease, box-shadow 0.15s ease;\par
    \}\par
\par
    .form-input:focus \{\par
      outline: none;\par
      border-color: var(--navy);\par
      box-shadow: 0 0 0 3px rgba(133, 142, 240, 0.25);\par
    \}\par
\par
    .form-input[aria-invalid="true"] \{\par
      border-color: var(--red);\par
      background: var(--error-bg);\par
    \}\par
\par
    .form-input:disabled \{\par
      background: #F4F6FF;\par
      color: var(--navy);\par
      border-color: var(--lavender);\par
      font-weight: 600;\par
    \}\par
\par
    .field-error \{\par
      display: none;\par
      font-size: 13px;\par
      color: var(--red);\par
      font-weight: 600;\par
    \}\par
\par
    .field-error.visible \{\par
      display: block;\par
    \}\par
\par
    /* Question Item Styling */\par
    .question-header \{\par
      display: flex;\par
      align-items: flex-start;\par
      justify-content: space-between;\par
      gap: var(--space-3);\par
      margin-bottom: var(--space-3);\par
    \}\par
\par
    .question-title \{\par
      margin: 0;\par
      font-size: 17px;\par
      font-weight: 700;\par
      color: var(--navy);\par
      line-height: 1.5;\par
    \}\par
\par
    .question-meta \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-2);\par
      flex-shrink: 0;\par
    \}\par
\par
    .source-tag \{\par
      font-size: 12px;\par
      font-weight: 600;\par
      background: #FFF3EB;\par
      color: #B84B0B;\par
      border: 1px solid var(--coral);\par
      padding: 2px 8px;\par
      border-radius: 6px;\par
      white-space: nowrap;\par
    \}\par
\par
    .point-tag \{\par
      font-size: 12px;\par
      font-weight: 700;\par
      background: var(--lavender);\par
      color: var(--navy);\par
      padding: 2px 8px;\par
      border-radius: 6px;\par
      white-space: nowrap;\par
    \}\par
\par
    .status-badge \{\par
      display: none;\par
      font-size: 12px;\par
      font-weight: 700;\par
      padding: 3px 10px;\par
      border-radius: 999px;\par
      white-space: nowrap;\par
    \}\par
\par
    .status-badge.correct \{\par
      display: inline-block;\par
      background: var(--success-bg);\par
      color: var(--success);\par
      border: 1px solid var(--success-border);\par
    \}\par
\par
    .status-badge.incorrect \{\par
      display: inline-block;\par
      background: var(--error-bg);\par
      color: var(--red);\par
      border: 1px solid var(--error-border);\par
    \}\par
\par
    /* Data Box & Frequency Table inside questions */\par
    .data-highlight-box \{\par
      background: #F4F6FF;\par
      border: 1.5px dashed var(--periwinkle);\par
      border-radius: 8px;\par
      padding: var(--space-3) var(--space-4);\par
      margin-bottom: var(--space-4);\par
      font-weight: 700;\par
      color: var(--navy);\par
      font-size: 17px;\par
      text-align: center;\par
      letter-spacing: 0.5px;\par
    \}\par
\par
    .table-wrapper \{\par
      overflow-x: auto;\par
      margin-bottom: var(--space-4);\par
    \}\par
\par
    .freq-table \{\par
      width: 100%;\par
      max-width: 460px;\par
      border-collapse: collapse;\par
      margin: 0 auto;\par
      font-size: 15px;\par
      border: 2px solid var(--navy);\par
      border-radius: 8px;\par
      overflow: hidden;\par
    \}\par
\par
    .freq-table th \{\par
      background: var(--navy);\par
      color: #FFFFFF;\par
      font-weight: 700;\par
      padding: 8px 14px;\par
      text-align: center;\par
      border: 1px solid var(--periwinkle);\par
    \}\par
\par
    .freq-table td \{\par
      padding: 8px 14px;\par
      text-align: center;\par
      border: 1px solid var(--periwinkle);\par
      font-weight: 600;\par
      color: var(--navy);\par
    \}\par
\par
    .freq-table tr:nth-child(even) td \{\par
      background: #EEF1FF;\par
    \}\par
\par
    .freq-table tr:nth-child(odd) td \{\par
      background: #FFFFFF;\par
    \}\par
\par
    .freq-table .highlight-var \{\par
      color: var(--red);\par
      font-weight: 700;\par
      font-size: 17px;\par
      background: #FFF3EB;\par
      padding: 2px 10px;\par
      border-radius: 4px;\par
      border: 1px solid var(--orange);\par
    \}\par
\par
    /* Radio Choices */\par
    .choices-list \{\par
      display: flex;\par
      flex-direction: column;\par
      gap: 10px;\par
    \}\par
\par
    .choice-label \{\par
      display: flex;\par
      align-items: center;\par
      gap: var(--space-3);\par
      padding: 12px 16px;\par
      border: 1.5px solid var(--border);\par
      border-radius: 10px;\par
      cursor: pointer;\par
      background: #FFFFFF;\par
      transition: all 0.15s ease;\par
      position: relative;\par
    \}\par
\par
    .choice-label:hover:not(.disabled) \{\par
      border-color: var(--periwinkle);\par
      background: #F8F9FE;\par
    \}\par
\par
    .choice-label.selected \{\par
      border-color: var(--navy);\par
      background: #F0F3FF;\par
      font-weight: 600;\par
    \}\par
\par
    .choice-label.disabled \{\par
      cursor: default;\par
    \}\par
\par
    .choice-label.correct-choice \{\par
      border-color: var(--success);\par
      background: var(--success-bg);\par
      color: #114B1E;\par
      font-weight: 700;\par
    \}\par
\par
    .choice-label.wrong-choice \{\par
      border-color: var(--red);\par
      background: var(--error-bg);\par
      color: var(--red);\par
      font-weight: 600;\par
    \}\par
\par
    .choice-radio \{\par
      width: 20px;\par
      height: 20px;\par
      accent-color: var(--navy);\par
      margin: 0;\par
      flex-shrink: 0;\par
      cursor: pointer;\par
    \}\par
\par
    .choice-label.disabled .choice-radio \{\par
      cursor: default;\par
    \}\par
\par
    .choice-text \{\par
      flex: 1;\par
      font-size: 16px;\par
    \}\par
\par
    .choice-feedback-tag \{\par
      font-size: 12px;\par
      font-weight: 700;\par
      padding: 2px 8px;\par
      border-radius: 6px;\par
    \}\par
\par
    .choice-feedback-tag.tag-correct \{\par
      background: var(--success);\par
      color: #FFFFFF;\par
    \}\par
\par
    .choice-feedback-tag.tag-wrong \{\par
      background: var(--red);\par
      color: #FFFFFF;\par
    \}\par
\par
    /* Explanation Box (Visible after grading) */\par
    .explanation-box \{\par
      display: none;\par
      margin-top: var(--space-4);\par
      padding: var(--space-4);\par
      background: #FFF9F5;\par
      border: 1.5px dashed var(--orange);\par
      border-radius: 10px;\par
      color: var(--body-ink);\par
    \}\par
\par
    .explanation-box.visible \{\par
      display: block;\par
    \}\par
\par
    .explanation-header \{\par
      font-weight: 700;\par
      color: var(--navy);\par
      margin-bottom: var(--space-2);\par
      display: flex;\par
      align-items: center;\par
      gap: 8px;\par
      font-size: 15px;\par
    \}\par
\par
    .explanation-steps \{\par
      margin: 0;\par
      padding-left: 20px;\par
      font-size: 15px;\par
    \}\par
\par
    .explanation-steps li \{\par
      margin-bottom: 6px;\par
    \}\par
\par
    .formula-block \{\par
      display: inline-block;\par
      background: #FFFFFF;\par
      border: 1px solid var(--lavender);\par
      padding: 4px 10px;\par
      border-radius: 6px;\par
      font-weight: 600;\par
      color: var(--navy);\par
      margin: 4px 0;\par
    \}\par
\par
    /* Validation Alert Banner */\par
    .validation-banner \{\par
      display: none;\par
      background: var(--error-bg);\par
      border: 1.5px solid var(--red);\par
      color: var(--red);\par
      padding: var(--space-4);\par
      border-radius: var(--radius);\par
      margin-bottom: var(--space-4);\par
      font-weight: 600;\par
      font-size: 15px;\par
    \}\par
\par
    .validation-banner.visible \{\par
      display: block;\par
    \}\par
\par
    /* Footer Actions */\par
    .quiz-actions \{\par
      display: flex;\par
      flex-wrap: wrap;\par
      align-items: center;\par
      justify-content: space-between;\par
      gap: var(--space-4);\par
      margin-top: var(--space-6);\par
    \}\par
\par
    .btn \{\par
      font: inherit;\par
      font-weight: 700;\par
      font-size: 16px;\par
      padding: 12px 24px;\par
      border-radius: 10px;\par
      border: 2px solid transparent;\par
      cursor: pointer;\par
      display: inline-flex;\par
      align-items: center;\par
      justify-content: center;\par
      gap: 8px;\par
      transition: all 0.15s ease;\par
    \}\par
\par
    .btn-primary \{\par
      background: var(--navy);\par
      color: #FFFFFF;\par
      box-shadow: 0 4px 10px rgba(0, 9, 107, 0.18);\par
    \}\par
\par
    .btn-primary:hover \{\par
      background: #0B168C;\par
    \}\par
\par
    .btn-accent \{\par
      background: var(--orange);\par
      color: var(--navy);\par
      border-color: var(--navy);\par
    \}\par
\par
    .btn-accent:hover \{\par
      background: #FFA368;\par
    \}\par
\par
    .btn-secondary \{\par
      background: var(--surface);\par
      color: var(--navy);\par
      border-color: var(--border);\par
    \}\par
\par
    .btn-secondary:hover \{\par
      background: #F0F3FF;\par
      border-color: var(--navy);\par
    \}\par
\par
    .btn:focus-visible \{\par
      outline: 3px solid var(--orange);\par
      outline-offset: 2px;\par
    \}\par
\par
    .filter-bar \{\par
      display: flex;\par
      gap: var(--space-2);\par
      flex-wrap: wrap;\par
    \}\par
\par
    .btn-filter \{\par
      font: inherit;\par
      font-size: 14px;\par
      font-weight: 600;\par
